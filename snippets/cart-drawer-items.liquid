<div class="cart-drawer-item flex-1 overflow-y-auto px-6 py-5">
  {% for item in cart.items %}
    <!-- Item -->
    <div class="flex gap-4 py-4 border-b border-neutral-200">
      <div class="size-24 rounded-xl overflow-hidden bg-neutral-100 shrink-0">
        {{ item.image | image_url: width: 200, height: 200 | image_tag: class: 'w-full h-full object-cover' }}
      </div>

      <div class="flex-1">
        <div class="flex justify-between gap-4">
          <div>
            <h3 class="font-medium">{{ item.title }}</h3>

            {% for option in item.options_with_values %}
              <p class="text-sm text-neutral-500 mt-1">{{ option.name }}: {{ option.value }}</p>
            {% endfor %}
          </div>

          <span class="font-semibold"> {{ item.original_price | money }} </span>
        </div>

        <div data-line-key="{{ item.key }}" class="flex items-center justify-between mt-4">
          <div class="flex items-center border border-neutral-300 rounded-lg">
            <button data-counter="minus" class="px-3 py-2 cursor-pointer">−</button>
            <span class="px-4 py-2 border-x border-neutral-300 qty"> {{ item.quantity }} </span>
            <button data-counter="plus" class="px-3 py-2 cursor-pointer">+</button>
          </div>

          <button class="btn-to-remove cursor-pointer text-sm text-neutral-500 hover:text-black">Remove</button>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
