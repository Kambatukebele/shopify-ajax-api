<section id="feature-product--{{ section.id }}" class="w-full featured-product">
  <div class="container mx-auto">
    <div class="w-full pb-4">
      <h2 class="text-3xl font-semibold">
        {{- section.settings.title -}}
      </h2>
    </div>
    <div class="w-full grid grid-cols-2 gap-3 lg:grid-cols-4">
      {%- for product in section.settings.product_list -%}
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        <div class="w-full flex flex-col gap-2">
          <!-- Product image -->
          <div class="w-full">
            {{
              product.featured_image
              | image_url: width: 600, height: 600
              | image_tag: class: 'w-full h-full block object-center object-cover product-image'
            }}
          </div>

          {% form 'product', product, class: 'product-form' %}
            <div class="flex flex-col gap-2">
              <input type="hidden" name="quantity" value="1">

              <!-- Variant ID -->
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                class="variant-id-input"
              >

              {%- assign selected_color = '' -%}
              {%- assign selected_color_index = null -%}

              <!-- COLOR SWATCHES -->
              <div class="w-full flex gap-1.5">
                {%- for color in product.options_with_values -%}
                  {% comment %} {{ color.selected_value }} {% endcomment %}
                  <hr>

                  <br>

                  {% comment %}
                    <span
                      data-color="{{ color | downcase }}"
                      style="background-color: {{- color | downcase -}}"
                      class="color-swatch w-4 h-4 md:w-5 md:h-5 block border border-gray-300 cursor-pointer rounded-full"
                    ></span>
                  {% endcomment %}
                {%- endfor -%}
              </div>

              <!-- SIZE BUTTONS -->
              <div class="w-full flex gap-1.5 flex-wrap size-buttons">
                {%- for size in product.options_by_name.Size.values -%}
                  <span
                    class="size-btn border border-gray-300 px-2 py-0.5 text-xs cursor-pointer"
                  >
                    {{- size -}}
                  </span>
                {%- endfor -%}
              </div>

              <!-- TEXT -->
              <div>
                <h4 class="text-lg font-medium">{{ product.title }}</h4>
                <span class="block text-sm font-light">
                  {% for collection in product.collections %}
                    {{ collection.title }}
                  {% endfor %}
                </span>
                <span class="block text-xl product-price">
                  {{ current_variant.price | money }}
                </span>
              </div>

              <!-- ADD TO CART -->
              <button
                type="submit"
                class="bg-blue-900 text-white block py-3 rounded cursor-pointer text-base uppercase add-to-cart-btn"
              >
                Add to cart
              </button>
            </div>
          {% endform %}
        </div>

      {%- else -%}
        {%- for item in (1..4) -%}
          <div class="w-full flex flex-col gap-2 ">
            <div class="max-w-75 snap-start shrink-0">
              {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-center object-cover' }}
            </div>
            <form class="product-form">
              <div class="flex flex-col gap-2">
                <input type="hidden" name="quantity" value="1">

                <!-- Variant ID -->
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  class="variant-id-input"
                >

                <!-- COLOR SWATCHES -->
                <div class="w-full flex gap-1.5">
                  <span
                    style="background-color: green"
                    class="color-swatch w-4 h-4 md:w-5 md:h-5 block border border-gray-300 cursor-pointer rounded-full"
                  ></span>
                </div>

                <!-- SIZE BUTTONS -->
                <div class="w-full flex gap-1.5 flex-wrap size-buttons">
                  <span
                    class="size-btn border border-gray-300 px-2 py-0.5 text-xs cursor-pointer"
                  >
                    32
                  </span>
                </div>

                <!-- TEXT -->
                <div>
                  <h4 class="text-lg font-medium">Running shoes</h4>
                  <span class="block text-sm font-light"> Collection </span>
                  <span class="block text-xl product-price"> $99 </span>
                </div>

                <!-- ADD TO CART -->
                <button
                  type="submit"
                  class="bg-blue-900 text-white block py-3 rounded cursor-pointer text-base uppercase add-to-cart-btn"
                >
                  Add to cart
                </button>
              </div>
            </form>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script></script>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured product"
    },
    {
      "type": "header",
      "content": "Products settings"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list",
      "limit": 4
    }
  ],
  "presets": [
    {
      "name": "Featured product"
    }
  ]
}
{% endschema %}
